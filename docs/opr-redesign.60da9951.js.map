        "vfW0pVMUrKQr": {
          "name": "Nascido do Lobo",
          "description": "Quando esta unidade for ativada, você pode mover todos os modelos com esta regra nela em até D3\"."
        },
        "vhXg_2pMyAzi": {
          "name": "Aura de Brutal Aprimorado",
          "description": "Este modelo e a sua unidade recebem Brutal Aprimorado."
        },
        "VI54cszY2BuG": {
          "name": "Estilhaçar",
          "description": "Para cada resultado não modificado de 6 para acertar, esses acertos recebem PA(+3)."
        },
        "VRSD2Brj6vAZ": {
          "name": "Marca de Ruína",
          "description": "Uma vez por ativação, antes de atacar, escolha uma unidade inimiga a até 18\" na linha de visão. Contra ela, unidades aliadas recebem Ruína nas suas armas ao atacar uma vez (na próxima vez que o efeito se aplicar)."
        },
        "vWhS9N4RI3yY": {
          "name": "Marca de Implacável",
          "description": "Uma vez por ativação, antes de atacar, escolha uma unidade inimiga a até 18\" na linha de visão. Contra ela, unidades aliadas recebem Implacável uma vez (na próxima vez que o efeito se aplicar)."
        },
        "w_vX0mi58KKt": {
          "name": "Explosão",
          "description": "Ignora Cobertura e, após resolver as outras regras especiais, cada acerto é multiplicado por X, sendo X até tantos acertos quanto modelos na unidade alvo."
        },
        "W3hSISDGStUH": {
          "name": "Crescimento de Precisão",
          "description": "Coloque um marcador nesta unidade no início de cada rodada se estiver em campo e não estiver Abalada, até um máximo de quatro marcadores. Para cada dois marcadores, modelos com esta regra nesta unidade recebem +1 nas rolagens para acertar."
        },
        "w7sENXkksVpG": {
          "name": "Devoto Aprimorado",
          "description": "Se este modelo tiver Devoto, o alvo sempre sofre acertos em resultados de acerto não modificados de 6 da regra Devoto (e não apenas ao atirar ou carregar inimigos a mais de 9\"/6\" de distância)."
        },
        "wC-cYJcNqGqv": {
