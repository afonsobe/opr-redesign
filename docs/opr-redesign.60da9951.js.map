        "Adrenaline Rush::Pick one friendly unit within 12\", which gets Enhanced Runner once (next time the effect would apply).": {
          "name": "Descarga de Adrenalina",
          "effect": "Escolha uma unidade aliada a até 12\", que recebe Corredor Aprimorado uma vez (na próxima vez que o efeito se aplicar)."
        },
        "Dark Shadow::Pick up to three friendly units within 18\", which get Stealth once (next time the effect would apply).": {
          "name": "Sombra Escura",
          "effect": "Escolha até três unidades aliadas a até 18\", que recebem Furtividade uma vez (na próxima vez que o efeito se aplicar)."
        },
        "Death from Above::Pick one enemy unit within 18\" in line of sight, which takes 9 hits.": {
          "name": "Morte do Alto",
          "effect": "Escolha uma unidade inimiga a até 18\" na linha de visão, que sofre 9 acertos."
        },
        "Hunting Potion::Pick up to two enemy units within 18\" in line of sight, which friendly units get +1 to hit rolls in melee against once (next time the effect would apply).": {
          "name": "Poção de Caça",
          "effect": "Escolha até duas unidades inimigas a até 18\" na linha de visão, contra as quais unidades aliadas recebem +1 nas rolagens para acertar em combate corpo a corpo uma vez (na próxima vez que o efeito se aplicar)."
        },
        "Raven Dart::Pick one enemy unit within 6\", which takes 1 hit with AP(2) and Deadly(3).": {
          "name": "Dardo do Corvo",
          "effect": "Escolha uma unidade inimiga a até 6\", que sofre 1 acerto com PA(2) e Mortal(3)."
        },
        "Swooping Attack::Pick one enemy unit within 18\" in line of sight, which takes 4 hits with Fracture. Roll as many dice as hits to see if \"on rolls of 6\" effects trigger.": {
          "name": "Ataque em Mergulho",
          "effect": "Escolha uma unidade inimiga a até 18\" na linha de visão, que sofre 4 acertos com Fratura. Role tantos dados quantos acertos para ver se os efeitos que ocorrem em rolagens de 6 são acionados."
        }
