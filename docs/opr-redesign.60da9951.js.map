    'about.forkLicense': '<a href="https://github.com/JeanOmeg/opr-card-generator/blob/master/LICENSE" target="_blank" rel="noopener">Licen\xe7a do projeto original</a>',
    'about.forkAuthor': '<a href="https://github.com/JeanOmeg" target="_blank" rel="noopener">JeanOmeg no GitHub</a>',
    'about.features': 'Recursos',
    'about.featureCards': "Uma carta imprim\xedvel por unidade: Qualidade / Defesa / Resist\xeancia, regras especiais, armas, notas.",
    'about.featureTables': "Tabela combinada de <strong>regras especiais</strong> (incluindo descri\xe7\xf5es de regras centrais/comuns) e uma <strong>tabela de magias</strong> para conjuradores.",
    'about.featureBg': "Imagem de <strong>fundo por carta</strong> (at\xe9 2 MB) com posicionamento por arrasto ou controles deslizantes, zoom por rolagem/controle, opacidade e centraliza\xe7\xe3o \u2014 salva no seu dispositivo por unidade e mantida entre atualiza\xe7\xf5es.",
