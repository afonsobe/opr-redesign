    overlay?.addEventListener('click', ()=>$e817d3341cf3ea9c$var$setDrawerOpen(false));
    for (const link of Array.from(document.querySelectorAll('[data-route]')))link.addEventListener('click', ()=>$e817d3341cf3ea9c$var$setDrawerOpen(false));
    window.addEventListener('hashchange', $e817d3341cf3ea9c$var$applyRoute);
    $e817d3341cf3ea9c$var$applyRoute();
}


var $eba15d725af817e2$exports = {};
$eba15d725af817e2$exports = JSON.parse('[{"date":"November 9, 2026","datePtBR":"9 de novembro de 2026","items":["**pt-BR dictionary now covers all 49 Grimdark Future army books from Army Forge:** 414 special rules, 2,095 weapons, 196 spells and 712 upgrade items translated, with terms kept consistent across armies.","**pt-BR dictionary now covers all 41 Age of Fantasy army books from Army Forge:** 390 special rules, 1,272 weapons, 189 spells and 744 upgrade items translated, with terminology kept consistent across armies and the exact-text lock preserved.","**pt-BR dictionary now covers all 48 Age of Fantasy: Skirmish army books from Army Forge:** 394 special rules, 906 weapons, 249 spells and 646 upgrade items translated, reusing Age of Fantasy translations only where the English text is identical and keeping the exact-text lock.","**Changelog entries from the same day now share one date heading** instead of repeating the date for each release."],"itemsPtBR":["**O dicion\xe1rio pt-BR agora cobre os 49 livros de ex\xe9rcito do Grimdark Future no Army Forge:** 414 regras especiais, 2.095 armas, 196 magias e 712 itens de melhoria traduzidos, com termos coerentes entre os ex\xe9rcitos.","**O dicion\xe1rio pt-BR agora cobre os 41 livros de ex\xe9rcito do Age of Fantasy no Army Forge:** 390 regras especiais, 1.272 armas, 189 magias e 744 itens de melhoria traduzidos, com terminologia coerente entre os ex\xe9rcitos e a trava pelo texto exato preservada.","**O dicion\xe1rio pt-BR agora cobre os 48 livros de ex\xe9rcito do Age of Fantasy: Skirmish no Army Forge:** 394 regras especiais, 906 armas, 249 magias e 646 itens de melhoria traduzidos, reaproveitando o Age of Fantasy apenas quando o ingl\xeas \xe9 id\xeantico e mantendo a trava pelo texto exato.","**Entradas do changelog do mesmo dia agora compartilham um \xfanico cabe\xe7alho de data** em vez de repetir a data para cada lan\xe7amento."]},{"date":"November 8, 2026","datePtBR":"8 de novembro de 2026","items":["**Classic cards in the same row now share the same height:** shorter cards stretch to match the tallest card in their row, while the TCG layout keeps its fixed card size.","**Fixed a wording slip in the pt-BR dictionary:** Fortified Growth now reads `recebem PA(-1)` instead of `sofrem PA(-1)`, matching the English `get AP(-1)` and the rest of the rules."],"itemsPtBR":["**As cartas cl\xe1ssicas de uma mesma linha agora t\xeam a mesma altura:** as cartas mais curtas se esticam at\xe9 a mais alta da linha, enquanto o layout TCG mant\xe9m o tamanho fixo.","**Corre\xe7\xe3o de texto no dicion\xe1rio pt-BR:** Crescimento Fortificado agora diz `recebem PA(-1)` em vez de `sofrem PA(-1)`, acompanhando o `get AP(-1)` do ingl\xeas e o restante das regras."]},{"date":"November 8, 2026","datePtBR":"8 de novembro de 2026","items":["**pt-BR dictionary now covers all 56 official GFF army books from Army Forge:** 415 special rules, 1,397 weapons, 256 spells and 652 upgrade items translated, with terms kept consistent across armies.","**Translations are locked to the exact Army Forge text:** a rule, weapon, spell or item is only translated while the English text returned by Army Forge matches the collected source; otherwise the current English is shown. Spells with the same name but different effects in different armies keep separate translations, and a single exception covers Army Forge\'s plural `Shock Weapons`.","**Terminology refinements:** deployment is now `posicionamento`, re-rolls read `rolar novamente`, the Hold action reads `Manter posi\xe7\xe3o`, and a few rules were reworded for Brazilian Portuguese."],"itemsPtBR":["**O dicion\xe1rio pt-BR agora cobre os 56 livros oficiais de ex\xe9rcito do GFF no Army Forge:** 415 regras especiais, 1.397 armas, 256 magias e 652 itens de melhoria traduzidos, com termos coerentes entre os ex\xe9rcitos.","**As tradu\xe7\xf5es ficam travadas ao texto exato do Army Forge:** regra, arma, magia ou item s\xf3 \xe9 traduzido enquanto o ingl\xeas retornado pelo Army Forge bater com a fonte coletada; caso contr\xe1rio, aparece o ingl\xeas atual. Magias com o mesmo nome e efeitos diferentes em ex\xe9rcitos distintos mant\xeam tradu\xe7\xf5es separadas, e uma \xfanica exce\xe7\xe3o cobre o plural `Shock Weapons` do Army Forge.","**Refinos de terminologia:** implanta\xe7\xe3o agora \xe9 `posicionamento`, rerrolagens viram `rolar novamente`, a a\xe7\xe3o Hold aparece como `Manter posi\xe7\xe3o` e algumas regras foram reescritas para o portugu\xeas do Brasil."]},{"date":"November 7, 2026","datePtBR":"7 de novembro de 2026","items":["**pt-BR dictionary now covers the full GFF army books collected from Army Forge:** Alien Hives and Battle Brothers, with 88 special rules, 156 weapons, 12 spells and 51 upgrade items translated.","**New Army Forge translation workflow:** the collector now accepts `--url` / `--urls-file`, the check runs via `npm run i18n:check`, and English source snapshots are kept per game system."],"itemsPtBR":["**O dicion\xe1rio pt-BR agora cobre os livros de ex\xe9rcito GFF coletados do Army Forge:** Alien Hives e Battle Brothers, com 88 regras especiais, 156 armas, 12 magias e 51 itens de melhoria traduzidos.","**Novo fluxo de tradu\xe7\xe3o do Army Forge:** o coletor aceita `--url` / `--urls-file`, as confer\xeancias rodam via `npm run i18n:check`, e as fontes em ingl\xeas s\xe3o salvas por sistema de jogo."]},{"date":"November 7, 2026","datePtBR":"7 de novembro de 2026","items":["**Cards now show heroes first, followed by other units in descending points order**, in both the on-screen list and print layout.","**The active palette colors are always visible** in the customization panel; changing either color automatically switches the selection to Custom.","**My Lists are now grouped by game system**, using the full official system names, which stay unchanged in English and pt-BR."],"itemsPtBR":["**As cartas agora mostram primeiro os her\xf3is e depois as demais unidades em ordem decrescente de pontos**, tanto na p\xe1gina quanto na impress\xe3o.","**As cores da paleta ativa ficam sempre vis\xedveis** no painel de personaliza\xe7\xe3o; ao alterar qualquer uma delas, a sele\xe7\xe3o muda automaticamente para Personalizado.","**Minhas Listas agora s\xe3o agrupadas por sistema de jogo**, com os nomes oficiais completos, que permanecem iguais em ingl\xeas e pt-BR."]},{"date":"November 6, 2026","datePtBR":"6 de novembro de 2026","items":["**Army summaries now show the main Army Forge book cover** in the upper-right corner, loaded directly from its public image URL.","**Hero units are easier to spot:** their cards have a subtle army-color accent and a localized **HERO / HER\xd3I** badge.","**Added an optional grayscale print setting.** It converts printed cards and tables to grayscale while leaving the on-screen palette unchanged.","**Standard card information now follows the softer Classic palette style** across stats, special rules, weapons, items and notes.","**Improved the army summary layout:** the book cover is centered vertically and Army Forge warnings sit closer to the army details.","**Generate Cards now uses a saved list for up to 6 hours** before requesting it from the server; Refresh buttons still always request the latest version.","**The site header now shows the app version** below the project name, so you can confirm which version is online.","**Netlify relay deploys now skip front-end-only pushes:** automatic builds continue only when api/, netlify/ or netlify.toml changes; the cards app remains published through GitHub Pages.","**Reorganized the print and customization controls** into separate panels for a clearer layout.","**Improved palette selection:** Automatic remains the default, while Default and Custom are listed under General; custom colors are saved separately for each army list.","**Moved the Classic image-size control** directly below Card design when a unit image is present."],"itemsPtBR":["**O resumo do ex\xe9rcito agora mostra a capa do livro principal do Army Forge** no canto superior direito, carregada diretamente pela URL p\xfablica da imagem.","**Unidades com Hero ficam mais f\xe1ceis de identificar:** as cartas recebem um detalhe sutil na cor do ex\xe9rcito e um selo localizado como **HERO / HER\xd3I**.","**Adicionada a op\xe7\xe3o de imprimir em escala de cinza.** Ela converte cartas e tabelas impressas para tons de cinza sem alterar a paleta na tela.","**As informa\xe7\xf5es das cartas Standard agora seguem o estilo de paleta suave do Classic** nos atributos, regras especiais, armas, itens e observa\xe7\xf5es.","**Melhorado o resumo do ex\xe9rcito:** a capa fica centralizada verticalmente e os avisos do Army Forge aparecem mais pr\xf3ximos dos detalhes.","**Gerar cartas agora usa uma lista salva por at\xe9 6 horas** antes de busc\xe1-la no servidor; os bot\xf5es de atualiza\xe7\xe3o continuam sempre buscando a vers\xe3o mais recente.","**O cabe\xe7alho do site agora mostra a vers\xe3o do app** abaixo do nome do projeto, para voc\xea confirmar qual vers\xe3o est\xe1 online.","**Os deploys do relay no Netlify agora ignoram pushes que alteram apenas o front-end:** os builds autom\xe1ticos s\xf3 continuam quando h\xe1 mudan\xe7as em api/, netlify/ ou netlify.toml; o app de cartas continua publicado pelo GitHub Pages.","**Reorganizados os controles de impress\xe3o e personaliza\xe7\xe3o** em pain\xe9is separados para deixar a tela mais clara.","**Melhorada a sele\xe7\xe3o de paletas:** Autom\xe1tico continua como padr\xe3o, enquanto Padr\xe3o e Personalizado ficam em Geral; as cores personalizadas s\xe3o salvas separadamente para cada lista de ex\xe9rcito.","**O controle de tamanho da imagem do Classic foi movido** para logo abaixo do design do card quando h\xe1 uma imagem de unidade."]},{"date":"November 5, 2026","datePtBR":"5 de novembro de 2026","items":["**Standard card title bars now have a fixed height** so artwork and stats line up across cards. Long unit names reduce their font size to stay within two lines.","**The full changelog is now available in pt-BR** when Portugu\xeas (BR) is selected; English entries remain unchanged.","**About page now credits the original project:** it identifies this app as a fork of JeanOmeg\'s OPR Card Generator, thanks the original author, and provides links to the original repository, app, profile, issues, releases and license.","**Added the Standard unit-card design** at 63.5 \xd7 88 mm, alongside Classic. Artwork is optional; when a Standard card has no image, the art window is removed in print and the remaining content expands to use the space. The selected design is saved per army list.","**Expanded image zoom for both card designs:** the control now ranges from 0.5\xd7 to 8\xd7, with 1\xd7 centered, and its sliders stay within the card width.","**Improved dark-mode readability for Standard cards on screen.** Printed colors remain unchanged.","**Improved pt-BR content translations:** GFF special rules, weapons, spells and items use the matching system dictionary; corrected AP (PA) display, item names such as **Camo Cloak**, and Sergeant weapon names.","**Palette labels are now consistent across languages:** army palettes show only the army name, without the color pairing.","**Spell table headings in pt-BR now use the format \u2018Magias - [book]\u2019.**","**Translation workflow organized by game system:** the Army Forge collector now saves English source snapshots per system and adds new pt-BR dictionary entries without overwriting existing translations. English source text stays separate from the translations, and the app selects the matching system dictionary.","**Items now render inside the weapons table** (same table, second section below the weapons): units with items such as **Eliminator Sniper** and **Camo Cloak** now show the item in the **Item** column and its granted rule (e.g. **Stealth**) in the **Special rules** column, aligned with the weapons table above.","**Weapon table headers fixed:** the **RNG**, **ATK** and **AP** column titles now use the same centered style as their values, fixing the horizontal offset between the title and the number.","**Unit special rules now include Tough with its value** (e.g. **Tough(9)**) and are sorted alphabetically, adding rules granted by items (e.g. **Stealth**) into the same line.","**Chosen Havoc Champion now shows its subtitle** (e.g. **Veteran Havoc Brother Leader**) when the part after the double-pipe separator is empty."],"itemsPtBR":["**As barras de t\xedtulo das cartas Standard agora t\xeam altura fixa** para alinhar as imagens e os atributos entre as cartas. Nomes longos reduzem a fonte para caber em at\xe9 duas linhas.","**O changelog completo agora est\xe1 dispon\xedvel em pt-BR** quando Portugu\xeas (BR) est\xe1 selecionado; as entradas em ingl\xeas permanecem inalteradas.","**A p\xe1gina Sobre agora reconhece o projeto original:** informa que este app \xe9 um fork do OPR Card Generator, de JeanOmeg, agradece ao autor e inclui links para o reposit\xf3rio original, o app, o perfil, as issues, as vers\xf5es e a licen\xe7a.","**Adicionado o design Standard para as cartas de unidade**, no tamanho 63,5 \xd7 88 mm, junto com o Classic. A imagem \xe9 opcional; quando uma carta Standard n\xe3o tem imagem, a \xe1rea da arte \xe9 removida na impress\xe3o e o restante do conte\xfado se expande para ocupar o espa\xe7o. O design escolhido fica salvo em cada lista de ex\xe9rcito.","**A faixa de zoom das imagens foi ampliada nos dois designs de carta:** agora vai de 0,5\xd7 a 8\xd7, com 1\xd7 no centro, e os controles deslizantes permanecem dentro da largura da carta.","**Melhorada a leitura das cartas Standard na tela em modo escuro.** As cores da impress\xe3o continuam iguais.","**Melhoradas as tradu\xe7\xf5es de conte\xfado pt-BR:** regras especiais, armas, magias e itens do GFF usam o dicion\xe1rio do sistema correspondente; foram corrigidas a exibi\xe7\xe3o de AP (PA), nomes de itens como **Camo Cloak** e nomes de armas de Sargento.","**Os nomes das paletas agora s\xe3o consistentes nos dois idiomas:** elas mostram apenas o nome do ex\xe9rcito, sem a combina\xe7\xe3o de cores.","**Os t\xedtulos das tabelas de magia em pt-BR agora seguem o formato \u2018Magias - [livro]\u2019.**","**O fluxo de tradu\xe7\xe3o foi organizado por sistema de jogo:** o coletor do Army Forge agora salva c\xf3pias do texto original em ingl\xeas por sistema e adiciona novas entradas ao dicion\xe1rio pt-BR sem sobrescrever tradu\xe7\xf5es existentes. O texto original em ingl\xeas fica separado das tradu\xe7\xf5es, e o app seleciona o dicion\xe1rio do sistema correspondente.","**Os itens agora aparecem na tabela de armas**, em uma segunda se\xe7\xe3o abaixo das armas: unidades com itens como **Eliminator Sniper** e **Camo Cloak** mostram o item na coluna **Item** e a regra concedida (por exemplo, **Stealth**) na coluna **Special rules**, alinhada \xe0 tabela de armas acima.","**Corrigidos os cabe\xe7alhos da tabela de armas:** os t\xedtulos das colunas **RNG**, **ATK** e **AP** agora ficam centralizados como os valores, corrigindo o desalinhamento horizontal entre o t\xedtulo e o n\xfamero.","**As regras especiais das unidades agora incluem o valor de Tough** (por exemplo, **Tough(9)**) e aparecem em ordem alfab\xe9tica; regras concedidas por itens (por exemplo, **Stealth**) tamb\xe9m s\xe3o inclu\xeddas na mesma linha.","**Chosen Havoc Champion agora exibe o subt\xedtulo** (por exemplo, **Veteran Havoc Brother Leader**) quando a parte ap\xf3s o separador de duas barras verticais est\xe1 vazia."]},{"date":"November 4, 2026","datePtBR":"4 de novembro de 2026","items":["**Fixed rated rules (e.g. AP) showing \'PA:PA\' / \'AP:AP\':** now falls back to the generic rule description by name for the active language (pt-BR shows full text, en-US shows English).","**Fixed per-system fallback mixing GF/GFF texts:** when a list has no dictionary for its game system, the UI now shows the English original instead of borrowing another system\'s translation.","**Printed special-rules and spells tables now use 2 columns**, matching the on-screen layout.","**Fixed a bug where weapon rules without an ID (e.g. Deadly(2) on Sniper Rifle) were missing from the special-rules table.**","**Translation dictionary rebuilt per game system:** collector now uses only the list\'s system (e.g. GFF), and runtime picks the matching section \u2014 GF/GFF/AoF texts no longer mix.","**Rebuilt dictionary from a single base list (Angels of Death - Ultramarines, GFF):** 61 rules, 59 weapons, 6 spells and 24 items, all freshly translated and verified against the live GFF source.","**Fixed 9 rule translations that were using GF text instead of GFF** (Strider, Hero, Parry, Flying, Brace, Impact, Musician, Blast, Banner) by re-translating from the live source.","**Removed \'Download All\' button:** cards are now downloaded individually via the PNG button on each card.","**Full pt-BR translation for Home / FAQ / Changelog / About:** all page texts (FAQ Q&A, About, changelog intro) now translate when the language is set to Portugu\xeas (BR).","**Fixed a bug where the home help callout showed \'undefined\':** the FAQ callout key was missing from the dictionary.","**Light theme is now the default** for first-time visitors. Dark mode is still available from the \u263E/\u2600 button and your choice is remembered on your device.","**New look:** cleaner horizontal navigation, a welcome section on the Home screen, better organized controls and option pills.","In **dark mode**, generated cards now use a dark paper background with light text, matching the rest of the interface \u2014 no more bright white cards on a dark page. **Printing is unchanged** and always uses white paper.","Improved color contrast for card names, costs, stats, weapons and special rules in both themes.","Updated the site address and SEO metadata to **https://afonsobe.github.io/opr-redesign/**.","**Unit content translation (pt-BR):** special rules, weapon special rules and spells are now translated when the language is set to Portugu\xeas (BR). Rule and spell names keep the original English term in parentheses (e.g. **Explos\xe3o (Blast)**) so you can match them to the English rulebook. Unit names and subtitles stay in English, as most players use the English rules.","**Language choice is remembered:** once you pick a language it becomes the default on this device.","Terms follow the community Brazilian Portuguese translation of the OPR rules; descriptions stay faithful to the original wording.","Added a translation memory file (`src/i18n/content.pt-BR.json`) plus a collector script (`scripts/collect-content.mjs`) so new rules from other army books can be translated and reviewed the same way.","**Translation dictionary expanded:** harvested 8 more army books (Robot Legions, Chaos Dwarfs, Dark Elves, Deep-Sea Elves, Human Defense Force, Depth One Reavers, Jackals, Human Defense Force 200pts). The dictionary now covers **178 special rules, 447 weapons, 42 spells and 154 upgrade items**, all translated to pt-BR.","Fixed an encoding issue that caused accented characters to display incorrectly; the dictionary file is now stored as ASCII-escaped JSON for safety.","**Site renamed to \'OPR Card Generator - Redesign\'** (title, meta tags and topbar).","**Print/PDF filename customized:** when printing, the file is now named with the game system abbreviation + army name (e.g. **GF - Space Marines Combat Patrol**) instead of the generic page title.","**Fixed broken accents in pt-BR translations:** 43 entries with replacement characters (`?gil` instead of `\xc1gil`) were restored from clean sources; the dictionary is now stored as UTF-8 so accented characters display correctly."],"itemsPtBR":["**Corrigida a exibi\xe7\xe3o de regras com valor** (por exemplo, AP) como \u2018PA:PA\u2019 / \u2018AP:AP\u2019: agora \xe9 usada a descri\xe7\xe3o gen\xe9rica da regra no idioma ativo (texto completo em pt-BR e ingl\xeas em en-US).","**Corrigida a mistura de textos de GF e GFF no fallback por sistema:** quando uma lista n\xe3o tem dicion\xe1rio para seu sistema de jogo, a interface agora mostra o original em ingl\xeas em vez de usar a tradu\xe7\xe3o de outro sistema.","**As tabelas impressas de regras especiais e magias agora usam 2 colunas**, como na exibi\xe7\xe3o na tela.","**Corrigido um erro que ocultava regras de armas sem ID** (por exemplo, Deadly(2) em Sniper Rifle) da tabela de regras especiais.","**O dicion\xe1rio de tradu\xe7\xf5es foi reconstru\xeddo por sistema de jogo:** o coletor agora usa somente o sistema da lista (por exemplo, GFF), e o app seleciona a se\xe7\xe3o correspondente \u2014 os textos de GF, GFF e AoF n\xe3o se misturam mais.","**Dicion\xe1rio reconstru\xeddo a partir de uma \xfanica lista-base** (Angels of Death - Ultramarines, GFF): 61 regras, 59 armas, 6 magias e 24 itens, todos retraduzidos e conferidos com a fonte GFF atual.","**Corrigidas 9 tradu\xe7\xf5es de regras que usavam o texto de GF em vez de GFF** (Strider, Hero, Parry, Flying, Brace, Impact, Musician, Blast e Banner), com novas tradu\xe7\xf5es baseadas na fonte correspondente.","**Removido o bot\xe3o \u2018Download All\u2019:** agora as cartas podem ser baixadas individualmente pelo bot\xe3o PNG de cada uma.","**Tradu\xe7\xe3o completa para pt-BR das p\xe1ginas Home, FAQ, Changelog e About:** os textos das p\xe1ginas (perguntas e respostas da FAQ, About e introdu\xe7\xe3o do changelog) agora s\xe3o traduzidos quando Portugu\xeas (BR) est\xe1 selecionado.","**Corrigida a mensagem de ajuda da p\xe1gina inicial que exibia \u2018undefined\u2019:** faltava a chave da chamada da FAQ no dicion\xe1rio.","**O tema claro agora \xe9 o padr\xe3o para quem visita o site pela primeira vez.** O modo escuro continua dispon\xedvel pelo bot\xe3o \u263E/\u2600, e a prefer\xeancia fica salva no dispositivo.","**Novo visual:** navega\xe7\xe3o horizontal mais limpa, se\xe7\xe3o de boas-vindas, op\xe7\xf5es mais organizadas e controles em formato de p\xedlula.","No **modo escuro**, as cartas geradas agora usam fundo escuro e texto claro, combinando com o restante da interface \u2014 sem folhas brancas brilhantes em uma p\xe1gina escura. **A impress\xe3o n\xe3o mudou** e continua usando papel branco.","Melhorado o contraste de cores dos nomes das cartas, custos, atributos, armas e regras especiais nos dois temas.","Atualizados o endere\xe7o do site e os metadados de SEO para **https://afonsobe.github.io/opr-redesign/**.","**Tradu\xe7\xe3o do conte\xfado das unidades para pt-BR:** regras especiais, regras especiais de armas e magias agora s\xe3o traduzidas quando Portugu\xeas (BR) est\xe1 selecionado. Os nomes das regras e magias mant\xeam o termo original em ingl\xeas entre par\xeanteses (por exemplo, **Explos\xe3o (Blast)**) para facilitar a consulta ao livro de regras em ingl\xeas. Nomes e subt\xedtulos das unidades continuam em ingl\xeas, como a maioria dos jogadores usa as regras nesse idioma.","**A escolha do idioma fica salva:** depois de selecionar um idioma, ele passa a ser o padr\xe3o neste dispositivo.","Os termos seguem a tradu\xe7\xe3o comunit\xe1ria brasileira das regras de OPR; as descri\xe7\xf5es continuam fi\xe9is ao texto original.","Adicionados um arquivo de mem\xf3ria de tradu\xe7\xe3o (`src/i18n/content.pt-BR.json`) e um script coletor (`scripts/collect-content.mjs`) para que novas regras de outros livros de ex\xe9rcito possam ser traduzidas e revisadas da mesma forma.","**Dicion\xe1rio de tradu\xe7\xf5es ampliado:** adicionados 8 livros de ex\xe9rcito (Robot Legions, Chaos Dwarfs, Dark Elves, Deep-Sea Elves, Human Defense Force, Depth One Reavers, Jackals e Human Defense Force 200pts). O dicion\xe1rio agora cont\xe9m **178 regras especiais, 447 armas, 42 magias e 154 itens de melhoria**, todos traduzidos para pt-BR.","Corrigido um problema de codifica\xe7\xe3o que fazia acentos aparecerem incorretamente; o arquivo do dicion\xe1rio agora usa caracteres ASCII escapados para evitar esse problema.","**O site passou a se chamar \u2018OPR Card Generator - Redesign\u2019** (t\xedtulo, metadados e barra superior).","**Personalizado o nome do arquivo de impress\xe3o/PDF:** agora ele inclui a sigla do sistema de jogo e o nome do ex\xe9rcito (por exemplo, **GF - Space Marines Combat Patrol**), em vez do t\xedtulo gen\xe9rico da p\xe1gina.","**Corrigidos acentos quebrados nas tradu\xe7\xf5es pt-BR:** 43 entradas com caracteres substitutos (`?gil` em vez de `\xc1gil`) foram restauradas de fontes corretas; o dicion\xe1rio agora \xe9 salvo em UTF-8 para exibir acentos corretamente."]},{"date":"July 22, 2026","datePtBR":"22 de julho de 2026","items":["**Light theme is now the default** for first-time visitors. Dark mode is still available from the \u263E/\u2600 button and your choice is remembered on your device.","**New look:** cleaner horizontal navigation, a welcome section on the Home screen, better organized controls and option pills.","In **dark mode**, generated cards now use a dark paper background with light text, matching the rest of the interface \u2014 no more bright white cards on a dark page. **Printing is unchanged** and always uses white paper.","Improved color contrast for card names, costs, stats, weapons and special rules in both themes.","Updated the site address and SEO metadata to **https://afonsobe.github.io/opr-redesign/**.","Fixed **duplicate rows** in the special-rules table for rated rules like **AP** and **Regeneration Aura**: a rule with several rating values (e.g. AP(1) and AP(2)) now shows up **once**, instead of once per value."],"itemsPtBR":["**O tema claro agora \xe9 o padr\xe3o para quem visita o site pela primeira vez.** O modo escuro continua dispon\xedvel pelo bot\xe3o \u263E/\u2600, e a prefer\xeancia fica salva no dispositivo.","**Novo visual:** navega\xe7\xe3o horizontal mais limpa, se\xe7\xe3o de boas-vindas, op\xe7\xf5es mais organizadas e controles em formato de p\xedlula.","No **modo escuro**, as cartas geradas agora usam fundo escuro e texto claro, combinando com o restante da interface \u2014 sem folhas brancas brilhantes em uma p\xe1gina escura. **A impress\xe3o n\xe3o mudou** e continua usando papel branco.","Melhorado o contraste de cores dos nomes das cartas, custos, atributos, armas e regras especiais nos dois temas.","Atualizados o endere\xe7o do site e os metadados de SEO para **https://afonsobe.github.io/opr-redesign/**.","Corrigidas as **linhas duplicadas** na tabela de regras especiais para regras com valor, como **AP** e **Regeneration Aura**: uma regra com v\xe1rios valores (por exemplo, AP(1) e AP(2)) agora aparece **uma \xfanica vez**."]},{"date":"July 6, 2026","datePtBR":"6 de julho de 2026","items":["Fixed a list **failing to load** (blank sheet) when a unit carried an item that grants a weapon but has no label of its own \u2014 e.g. an **Energy Shield** that also gives a **Bash** attack. The card now shows the bundled weapon (e.g. **5x Bash (A1)**) instead of crashing."],"itemsPtBR":["Corrigido um erro que fazia uma lista **n\xe3o carregar** (a p\xe1gina ficava em branco) quando uma unidade tinha um item que concede uma arma, mas n\xe3o tem nome pr\xf3prio \u2014 por exemplo, um **Energy Shield** que tamb\xe9m concede um ataque **Bash**. Agora a carta mostra a arma concedida (por exemplo, **5x Bash (A1)**) em vez de causar um erro."]},{"date":"July 5, 2026","datePtBR":"5 de julho de 2026","items":["A **Hero** joined to a unit in Army Forge now shows a **\uD83D\uDD17 Joined to <unit>** marker on its card (e.g. **Joined to Warriors**), matching Army Forge \u2014 so it\'s clear the hero and its unit **activate together** and the activation count adds up.","Cards are now sorted **alphabetically** by unit name, and a **joined Hero** is always placed **right after the unit it joins** (e.g. the ONIs card, then its Dynasty Leader), making the sheet much easier to read.","The base line on each card now also shows the **army name** and **game system** before the base size \u2014 e.g. **Eternal Dynasty - GF - 60x35mm** \u2014 so cards from different lists don\'t get mixed up when you print several armies and shuffle them together."],"itemsPtBR":["Um **Hero** unido a uma unidade no Army Forge agora exibe na carta o indicador **\uD83D\uDD17 Joined to <unit>** (por exemplo, **Joined to Warriors**), como no Army Forge \u2014 deixando claro que o her\xf3i e sua unidade **ativam juntos** e contam para o total de ativa\xe7\xf5es.","As cartas agora s\xe3o ordenadas **alfabeticamente** pelo nome da unidade, e um **Hero unido** aparece sempre **logo depois da unidade** \xe0 qual est\xe1 ligado (por exemplo, a carta ONIs seguida pela Dynasty Leader), facilitando a leitura da folha.","A linha da base de cada carta agora tamb\xe9m mostra o **nome do ex\xe9rcito** e o **sistema de jogo** antes do tamanho da base \u2014 por exemplo, **Eternal Dynasty - GF - 60x35mm** \u2014 para evitar misturar cartas de listas diferentes ao imprimir v\xe1rios ex\xe9rcitos."]},{"date":"July 2, 2026","datePtBR":"2 de julho de 2026","items":["The army header (name, points, activations and game system) now also appears above the **spells table**, and a matching **on-screen summary** shows right below the print options so those totals stay visible while you scroll through many cards. The summary is not printed.","Fixed the **points** on a card showing only the unit\'s **base cost** and ignoring its upgrades: the card now shows the unit\'s **real total**, upgrades included \u2014 e.g. a **Gecko Champion** with a Starseer Palanquin and Priest upgrade now reads **85 pts** instead of **30 pts**."],"itemsPtBR":["O cabe\xe7alho do ex\xe9rcito (nome, pontos, ativa\xe7\xf5es e sistema de jogo) agora tamb\xe9m aparece acima da **tabela de magias**, e um **resumo na tela** \xe9 exibido logo abaixo das op\xe7\xf5es de impress\xe3o para manter esses totais vis\xedveis durante a rolagem. O resumo n\xe3o \xe9 impresso.","Corrigida a exibi\xe7\xe3o dos **pontos** da carta, que mostrava apenas o **custo base** da unidade e ignorava melhorias: agora a carta mostra o **total real**, incluindo melhorias \u2014 por exemplo, um **Gecko Champion** com Starseer Palanquin e melhoria Priest passa a mostrar **85 pts** em vez de **30 pts**."]},{"date":"June 30, 2026","datePtBR":"30 de junho de 2026","items":["Units merged with the **Combine Units** rule (two same-type units fielded as one larger unit) now render as a **single card** with their models, points and weapons added together \u2014 e.g. two 5-model squads become one **Battle Brothers [10]** card showing both squads\' weapons. This always applies, regardless of the **Combine similar units** option.","Reworked **Combine similar units**: identical cards now combine regardless of how many models they have (combining is purely cosmetic, to save paper), up to **3 cards** per combined card. A combined card keeps the **original** card\'s points and weapon quantities instead of multiplying them.","The model count no longer shows next to the points; it now appears next to the card name as **[N]**, e.g. **3x Battle Brothers [5]**.","The **FAQ** now also appears right on the **Home** screen whenever no army is loaded, so you can read how to use the app without opening the FAQ page. The dedicated FAQ page is still there too.","The army header above the **special-rules table** now shows the **activation count** (e.g. **250 / 250 pts \xb7 8 activations \xb7 AOFS**), making it easy to tell how many units you really have when similar cards were combined.","Leaving the **Home** screen now clears the loaded army, so coming back to Home shows the **FAQ** again instead of your previous cards \u2014 a temporary nudge to help everyone learn how to use the app.","Changed the default options: **Use custom unit names** is now **on** and **Combine similar units** is now **off** by default, and the print/option checkboxes were reordered (cards, rules, spells, custom names, combine).","Cards built from two units merged by the **Combine Units** rule now show a **Combined** badge next to the points, making it obvious when units were combined (sometimes by accident in Army Forge)."],"itemsPtBR":["Unidades combinadas pela regra **Combine Units** (duas unidades do mesmo tipo agrupadas como uma unidade maior) agora s\xe3o exibidas em **uma \xfanica carta**, com modelos, pontos e armas somados \u2014 por exemplo, dois esquadr\xf5es de 5 modelos viram uma **Battle Brothers [10]** com as armas dos dois esquadr\xf5es. Isso sempre acontece, independentemente da op\xe7\xe3o **Combine similar units**.","A op\xe7\xe3o **Combine similar units** foi reformulada: cartas id\xeanticas agora s\xe3o agrupadas independentemente da quantidade de modelos (o agrupamento \xe9 apenas visual, para economizar papel), at\xe9 **3 cartas** em uma. A carta agrupada mant\xe9m os pontos e as quantidades de armas da carta **original**, sem multiplic\xe1-los.","A quantidade de modelos deixou de aparecer ao lado dos pontos e passou a aparecer ao lado do nome da carta como **[N]** \u2014 por exemplo, **3x Battle Brothers [5]**.","A **FAQ** agora tamb\xe9m aparece na tela **Home** sempre que n\xe3o h\xe1 um ex\xe9rcito carregado, para que voc\xea veja como usar o app sem abrir a p\xe1gina FAQ. A p\xe1gina dedicada da FAQ continua dispon\xedvel.","O cabe\xe7alho do ex\xe9rcito acima da **tabela de regras especiais** agora mostra o **total de ativa\xe7\xf5es** (por exemplo, **250 / 250 pts \xb7 8 activations \xb7 AOFS**), facilitando a confer\xeancia de quantas unidades h\xe1 quando cartas semelhantes s\xe3o agrupadas.","Ao sair da tela **Home**, o ex\xe9rcito carregado agora \xe9 limpo. Assim, ao voltar para Home, a **FAQ** \xe9 exibida novamente no lugar das cartas anteriores \u2014 um lembrete tempor\xe1rio para ajudar novos usu\xe1rios a conhecer o app.","Alteradas as op\xe7\xf5es padr\xe3o: **Use custom unit names** agora fica ativada e **Combine similar units** desativada. As caixas de sele\xe7\xe3o de impress\xe3o e op\xe7\xf5es tamb\xe9m foram reordenadas (cartas, regras, magias, nomes personalizados e agrupamento).","Cartas criadas a partir de duas unidades combinadas pela regra **Combine Units** agora mostram o selo **Combined** ao lado dos pontos, deixando claro quando as unidades foram agrupadas (\xe0s vezes sem querer no Army Forge)."]},{"date":"June 29, 2026","datePtBR":"29 de junho de 2026","items":["Added **Horizontal** and **Vertical** sliders to each card\'s image controls, so you can reposition a background image with the sliders instead of only dragging it \u2014 much easier on phones and tablets.","Your per-list options (**Combine similar units**, **Use custom unit names**, and the print include toggles) are now **saved with each list** and restored when you load it from **My Lists**, instead of resetting every time."],"itemsPtBR":["Adicionados controles deslizantes **Horizontal** e **Vertical** aos controles de imagem de cada carta, permitindo reposicionar a imagem de fundo pelos controles em vez de apenas arrast\xe1-la \u2014 muito mais f\xe1cil em celulares e tablets.","As op\xe7\xf5es de cada lista (**Combine similar units**, **Use custom unit names** e as op\xe7\xf5es de inclus\xe3o na impress\xe3o) agora ficam **salvas com a lista** e s\xe3o restauradas ao carreg\xe1-la em **My Lists**, em vez de serem redefinidas."]},{"date":"June 27, 2026","datePtBR":"27 de junho de 2026","items":["Fixed **combined unit cards** showing only one unit\'s points, model count and weapon quantities: a card for several merged units (e.g. **3x Mercenary Hunter**) now totals them correctly \u2014 e.g. **45 pts \xb7 3 models** with **3x Bow** \u2014 instead of **15 pts \xb7 1 model**.","Fixed model upgrades that grant a rule (e.g. upgrading one model to a **Sergeant**) not showing on the card; they now appear under **Special Rules** as **1x Sergeant** and their description is listed in the special-rules table, matching Army Forge.","Fixed **My Lists** showing up empty after you loaded, generated or refreshed a list \u2014 your saved lists now appear right away when you open the page, without needing to reload (F5) first.","Added a **Use custom unit names** option (off by default): turn it on to show a unit\'s custom name from Army Forge (e.g. **Frodo**) as the card title, with the book name moving to the subtitle. Left off, cards keep showing the default unit name.","Card **background images now stick around**: the image you add \u2014 plus its zoom, position and opacity \u2014 is saved on your device per unit, so it\'s still there when you reload or come back later. On **Refresh List** it stays as long as the unit is still in the list, and is cleaned up automatically once the unit (or the whole list) is removed. Background images are limited to 2 MB each.","Added a **Combine similar units** option (on by default): identical single-model units now collapse into a single card prefixed with their count (e.g. **3x Tribe Spider Rig**), matching Army Forge. Multi-model units always stay on their own card, and unchecking the option shows every unit separately.","Identical weapons carried by several models are now merged into a single line with a combined quantity (e.g. three daggers show as **3x Dagger (A2)**), matching how Army Forge groups them, instead of repeating the same weapon once per model.","Fixed weapons whose quantity was already part of the name (e.g. **Tribe Champion**\'s **2x Hand Weapon**) showing the multiplier twice, as in **2x 2x Hand Weapon (A2)**. The quantity now appears only once."],"itemsPtBR":["Corrigidas as **cartas de unidades agrupadas** que mostravam os pontos, a quantidade de modelos e as quantidades de armas de apenas uma unidade: agora a carta de v\xe1rias unidades combinadas (por exemplo, **3x Mercenary Hunter**) soma corretamente os valores \u2014 por exemplo, **45 pts \xb7 3 modelos** com **3x Bow** \u2014 em vez de **15 pts \xb7 1 modelo**.","Corrigidas melhorias de modelo que concedem uma regra (por exemplo, melhorar um modelo para **Sergeant**) e n\xe3o apareciam na carta; agora elas aparecem em **Special Rules** como **1x Sergeant**, e sua descri\xe7\xe3o entra na tabela de regras especiais, como no Army Forge.","Corrigida a p\xe1gina **My Lists**, que aparecia vazia depois de carregar, gerar ou atualizar uma lista: agora as listas salvas aparecem assim que a p\xe1gina \xe9 aberta, sem precisar recarregar (F5).","Adicionada a op\xe7\xe3o **Use custom unit names** (desativada por padr\xe3o): ative-a para usar como t\xedtulo da carta o nome personalizado da unidade no Army Forge (por exemplo, **Frodo**) e mover o nome do livro para o subt\xedtulo. Desativada, a carta continua usando o nome padr\xe3o da unidade.","As **imagens de fundo das cartas agora s\xe3o mantidas**: a imagem adicionada, junto com zoom, posi\xe7\xe3o e opacidade, fica salva no dispositivo para continuar dispon\xedvel ao recarregar ou voltar depois. Ao usar **Refresh List**, ela permanece enquanto a unidade ainda estiver na lista e \xe9 removida automaticamente quando a unidade (ou a lista inteira) for exclu\xedda. Cada imagem pode ter at\xe9 2 MB.","Adicionada a op\xe7\xe3o **Combine similar units** (ativada por padr\xe3o): unidades id\xeanticas de um modelo agora s\xe3o agrupadas em uma carta com a quantidade no in\xedcio (por exemplo, **3x Tribe Spider Rig**), como no Army Forge. Unidades com v\xe1rios modelos continuam em cartas separadas; desative a op\xe7\xe3o para mostrar cada unidade individualmente.","Armas id\xeanticas usadas por v\xe1rios modelos agora s\xe3o reunidas em uma linha com a quantidade total (por exemplo, tr\xeas adagas aparecem como **3x Dagger (A2)**), como no Army Forge, em vez de repetir a arma para cada modelo.","Corrigidas armas cuja quantidade j\xe1 fazia parte do nome (por exemplo, **2x Hand Weapon** do **Tribe Champion**), que exibiam o multiplicador duas vezes, como em **2x 2x Hand Weapon (A2)**. Agora a quantidade aparece uma \xfanica vez."]},{"date":"June 26, 2026","datePtBR":"26 de junho de 2026","items":["Fixed upgrades that arrived without a label (e.g. **Combat Shield**) showing up as an empty blank pill; they now display their name plus the rule they grant, e.g. **Combat Shield (Shielded)**.","Granted abilities that name another rule in their text (e.g. **Reanimation Aura** grants **Reanimation**, **Repel Ambushers** mentions **Ambush**) now also list that referenced rule in the special-rules table instead of leaving it undefined.","Weapons now show their quantity (e.g. **8x Rifle (24\\", A1)**) instead of hiding how many of each weapon the unit carries.","Items that are actually weapons (such as **Weapon Team**) now appear in the **Weapons** section instead of being listed under Special Rules.","**Generate Cards** now loads instantly from your saved copy when the list is already cached \u2014 use the new **Refresh List** button to pull the latest version from Army Forge when you need it.","Added **Changelog** and **About** pages."],"itemsPtBR":["Corrigidos aprimoramentos que chegavam sem nome (por exemplo, **Combat Shield**) e apareciam como uma p\xedlula vazia; agora exibem o nome e a regra concedida, como **Combat Shield (Shielded)**.","Habilidades concedidas que mencionam outra regra em sua descri\xe7\xe3o (por exemplo, **Reanimation Aura** concede **Reanimation**, e **Repel Ambushers** menciona **Ambush**) agora tamb\xe9m incluem essa regra na tabela de regras especiais, em vez de deix\xe1-la sem defini\xe7\xe3o.","As armas agora mostram sua quantidade (por exemplo, **8x Rifle (24\\", A1)**) em vez de ocultar quantas unidades de cada arma a unidade carrega.","Itens que na verdade s\xe3o armas (como **Weapon Team**) agora aparecem na se\xe7\xe3o **Weapons**, em vez de serem listados em Special Rules.","**Generate Cards** agora carrega instantaneamente a c\xf3pia salva quando a lista j\xe1 est\xe1 em cache. Use o novo bot\xe3o **Refresh List** para buscar a vers\xe3o mais recente no Army Forge quando necess\xe1rio.","Adicionadas as p\xe1ginas **Changelog** e **About**."]}]');



// Turn an item string into DOM nodes, converting **bold** spans into <strong>
// so the data file stays plain text instead of raw HTML.
function $c4e6bd9e8cdf8fda$var$appendFormatted(target, text) {
    const parts = text.split(/\*\*(.+?)\*\*/g);
    parts.forEach((part, index)=>{
        if (!part) return;
        if (index % 2 === 1) {
            const strong = document.createElement('strong');
            strong.textContent = part;
            target.appendChild(strong);
        } else target.appendChild(document.createTextNode(part));
    });
}
