          "description": "When this unit is activated, pick one effect: until the end of the activation, all models with this rule in this unit either get +4\" range when shooting or move +2\" when charging."
        },
        "YfecqBW3YoNG": {
          "name": "Enhanced Fortified",
          "description": "If most models in this unit have Fortified, hits they take count as having AP(-2) from Fortified (instead of only AP(-1))."
        },
        "YI4Qxaiu6pAu": {
          "name": "Enhanced Royal Legion",
          "description": "If this model has Royal Legion, it gets +8\"/+4\" range when shooting/charging from Royal Legion (instead of only +4\"/+2\")."
        },
        "yis0utoPMclv": {
          "name": "Lustbound",
          "description": "Moves +1\" when using Advance, and +2\" when using Rush/Charge."
        },
        "ykPufsAeq8Kw": {
          "name": "Quick Shot",
          "description": "This model may shoot after using Rush actions."
        },
        "YMQxz2ssYCBj": {
          "name": "Shrouded",
          "description": "When a unit where most models have this rule is targeted by an enemy unit for shooting/charging, that enemy unit gets -4\"/-2\" range to a min. of 6\"."
        },
        "ymrWMYEn2noy": {
          "name": "Versatile Warrior Aura",
          "description": "This model and its unit get Versatile Warrior."
        },
        "ynbkYi-zak_C": {
          "name": "Regeneration Buff",
          "description": "Once per activation, before attacking, pick one friendly unit within 12\", which gets Regeneration once (next time the effect would apply)."
        },
        "ypa2nY7DC-X0": {
          "name": "Precision Feat",
          "description": "Once per game, when this unit attacks, you may use this rule so that all models with this rule in it get +1 to hit rolls."
        },
        "ySpZadCu08yk": {
          "name": "Enhanced Precision Marksman",
          "description": "If this model has Precision Marksman, it always gets +1 to hit rolls from Precision Marksman (instead of only when shooting over 9\" away)."
        },
        "ywXKQKPOLjTF": {
          "name": "Banner",
          "description": "This model and its unit get +1 to Morale Test rolls triggered by shooting/melee."
        },
        "z4QuSO_AxqDr": {
          "name": "Versatile Expert",
          "description": "When this unit is activated, pick one effect: until the end of the activation all models with this rule in this unit either get AP(+1) when attacking, or get +1 to hit rolls when attacking."
        },
        "zCjAFXut7Gsg": {
          "name": "Retaliate",
          "description": "When this model takes wounds in melee, the attacker takes X hits per wound taken."
        },
        "ZELpixQq0iEf": {
          "name": "Reckless Piercing Aura",
          "description": "This model and its unit get Reckless Piercing."
        },
        "zGew9XZT2rUm": {
          "name": "Relentless Aura",
          "description": "This model and its unit get Relentless."
        },
        "ZGxUXLWSGkCv": {
          "name": "Enhanced Shadowborn",
          "description": "If most models in this unit have Shadowborn, enemy units shooting/charging it get -8\"/-4\" range to a min. of 6\" from Shadowborn (instead of only -4\"/-2\")."
        },
        "ZHykLbU6nUWl": {
          "name": "Spawn",
          "description": "Once per game, when this model is activated, you may place a new unit of X fully within 6\" of it. Units placed via Spawn can’t seize or contest objectives on the round they are placed."
        },
        "Zi1Zgge5ptMw": {
          "name": "Enhanced Havocbound Aura",
          "description": "This model and its unit get Enhanced Havocbound."
        },
        "ZIv6EGqwQuer": {
          "name": "Fatigue Debuff",
          "description": "Once per activation, before attacking, pick one enemy unit within 18\" in line of sight, which must take a Morale Test. If failed, it becomes Fatigued."
        },
        "zjzB46LX-QDg": {
          "name": "Re-Deployment",
          "description": "After all other units are deployed (excluding units that were set aside), you may remove up to two friendly units from the table and deploy them again. Players alternate in placing Re-Deployment units, starting with the player that activates next."
        },
        "ZqYITWnZUc45": {
          "name": "Enhanced Havocbound",
          "description": "If this model has Havocbound, it always gets AP(+1) from Havocbound (instead of only when shooting/charging enemies over 9\"/6\" away)."
        },
        "zTfg9msVpfJ0": {
          "name": "Guarded",
          "description": "If most models in this unit have this rule, they get +1 to Defense rolls when shot/charged from over 9\"/6\" away."
        },
        "zu6H7MyN3f8U": {
          "name": "Warding",
          "description": "When a unit where most models have this rule takes wounds, roll one die for each. If the wound was from a spell, then it is ignored on a 2+. If the wound was not from a spell, and the unit was shot/charged from over 9\"/6\" away, then it is ignored on a 6+ instead."
        },
        "zUTRifMzhyrR": {
          "name": "Enhanced Bestial",
          "description": "If this model has Bestial, enemies taking hits from it must re-roll successful unmodified Defense results of 5-6 from Bestial (instead of only results of 6)."
        },
        "zVconc6Qb-g9": {
          "name": "Heavy Impact",
          "description": "Counts as having Impact(X) with hits that have AP(1)."
        },
        "ZW_Zv-kkBt2q": {
          "name": "Shielded Aura",
          "description": "This model and its unit get Shielded."
        },
        "Zx4mWN0SbmK8": {
          "name": "Reliable",
          "description": "Attacks at Quality 2+."
        }
