          "name": "Bom Combatente",
          "description": "Este modelo recebe +1 nas rolagens para acertar em combate corpo a corpo."
        },
        "XTLizAKBVOIZ": {
          "name": "Bônus de Defesa",
          "description": "Uma vez por ativação, antes de atacar, escolha uma unidade aliada a até 12\"; ela recebe +1 nas rolagens de Defesa uma vez (na próxima vez que o efeito se aplicar)."
        },
        "XWsun1sjt2ql": {
          "name": "Bônus de Corrida Rápida",
          "description": "Uma vez por ativação, antes de atacar, escolha uma unidade aliada a até 12\". Ela recebe Corrida Rápida uma vez (na próxima vez que o efeito se aplicar)."
        },
        "Y37_ydVGvRqL": {
          "name": "Aura de Avanço Rápido",
          "description": "Este modelo e a sua unidade recebem Avanço Rápido."
        },
        "y47PXwakTSji": {
          "name": "Alcance Versátil",
          "description": "Quando esta unidade é ativada, escolha um efeito: até o fim da ativação, todos os modelos com esta regra nesta unidade recebem +4\" de alcance ao atirar ou movem +2\" ao usar Corrida/Carga."
        },
        "YfecqBW3YoNG": {
          "name": "Fortificado Aprimorado",
          "description": "Se a maioria dos modelos nesta unidade tiver Fortificado, os acertos que recebem contam como tendo PA(-2) por Fortificado (em vez de apenas PA(-1))."
        },
        "YI4Qxaiu6pAu": {
          "name": "Legião Real Aprimorada",
          "description": "Se este modelo tiver Legião Real, ele recebe +8\"/+4\" de alcance ao atirar ou carregar por Legião Real (em vez de apenas +4\"/+2\")."
        },
        "yis0utoPMclv": {
          "name": "Atrelado à Luxúria",
          "description": "Move +1\" ao usar Avanço e +2\" ao usar Corrida/Carga."
        },
        "ykPufsAeq8Kw": {
          "name": "Tiro Rápido",
          "description": "Este modelo pode atirar após usar ações de Corrida."
        },
        "YMQxz2ssYCBj": {
          "name": "Encoberto",
          "description": "Quando uma unidade em que a maioria dos modelos tem esta regra é escolhida como alvo de tiros ou carga por uma unidade inimiga, essa unidade inimiga sofre -4\"/-2\" no alcance, até um mínimo de 6\"."
        },
        "ymrWMYEn2noy": {
          "name": "Aura de Combatente Versátil",
          "description": "Este modelo e a sua unidade recebem Combatente Versátil."
        },
        "ynbkYi-zak_C": {
          "name": "Bônus de Regeneração",
          "description": "Uma vez por ativação, antes de atacar, escolha uma unidade aliada a até 12\". Ela recebe Regeneração uma vez (na próxima vez que o efeito se aplicar)."
        },
        "ypa2nY7DC-X0": {
          "name": "Feito de Precisão",
          "description": "Uma vez por jogo, quando esta unidade atacar, você pode usar esta regra para que todos os modelos com esta regra nela recebam +1 nas rolagens para acertar."
        },
        "ySpZadCu08yk": {
          "name": "Atirador de Precisão Aprimorado",
          "description": "Se este modelo tiver Atirador de Precisão, sempre recebe +1 nas rolagens para acertar por Atirador de Precisão (em vez de apenas ao atirar contra inimigos a mais de 9\" de distância)."
        },
        "ywXKQKPOLjTF": {
          "name": "Estandarte",
          "description": "Este modelo e a sua unidade recebem +1 nas rolagens de Teste de Moral causadas por tiro/combate corpo a corpo."
        },
        "z4QuSO_AxqDr": {
          "name": "Perito Versátil",
          "description": "Quando esta unidade é ativada, escolha um efeito: até o fim da ativação, todos os modelos com esta regra nesta unidade recebem PA(+1) ao atacar ou +1 nas rolagens de acerto ao atacar."
        },
        "zCjAFXut7Gsg": {
          "name": "Retaliação",
          "description": "Quando este modelo sofre ferimentos em combate corpo a corpo, o atacante sofre X acertos por ferimento sofrido."
        },
        "ZELpixQq0iEf": {
          "name": "Aura de Perfurante Imprudente",
          "description": "Este modelo e a sua unidade recebem Perfurante Imprudente."
        },
        "zGew9XZT2rUm": {
          "name": "Aura de Implacável",
          "description": "Este modelo e a sua unidade recebem Implacável."
        },
        "ZGxUXLWSGkCv": {
          "name": "Sombrio Aprimorado",
          "description": "Se a maioria dos modelos nesta unidade tiver Sombrio, inimigos que a atirem ou carreguem sempre sofrem -8\"/-4\" de alcance até um mínimo de 6\" por Sombrio (em vez de apenas -4\"/-2\")."
        },
        "ZHykLbU6nUWl": {
          "name": "Procriação",
          "description": "Uma vez por jogo, quando este modelo for ativado, você pode colocar uma nova unidade de X totalmente a até 6\" dele. Unidades colocadas por Procriação não podem tomar nem contestar objetivos na rodada em que são colocadas."
        },
        "Zi1Zgge5ptMw": {
          "name": "Aura de Devastação Aprimorado",
          "description": "Este modelo e a sua unidade recebem Devastação Aprimorado."
        },
        "ZIv6EGqwQuer": {
          "name": "Penalidade de Fadiga",
          "description": "Uma vez por ativação, antes de atacar, escolha uma unidade inimiga a até 18\" na linha de visão. Ela deve fazer um Teste de Moral. Se falhar, fica Fatigada."
        },
        "zjzB46LX-QDg": {
          "name": "Reposicionamento",
          "description": "Após todas as outras unidades serem posicionadas (exceto as que foram deixadas de lado), você pode retirar até duas unidades aliadas da mesa e posicioná-las novamente. Os jogadores alternam o posicionamento de unidades com Reposicionamento, começando pelo jogador que será o próximo a ativar."
        },
        "ZqYITWnZUc45": {
          "name": "Devastação Aprimorado",
          "description": "Se este modelo tiver Devastação, ele sempre recebe PA(+1) dela (em vez de apenas quando atira ou carrega inimigos a mais de 9\"/6\" de distância)."
        },
        "zTfg9msVpfJ0": {
          "name": "Protegido",
          "description": "Se a maioria dos modelos nesta unidade tiver esta regra, a unidade recebe +1 nas rolagens de Defesa quando for alvo de tiros ou de uma carga iniciada a mais de 9\"/6\" de distância."
        },
        "zu6H7MyN3f8U": {
          "name": "Proteção",
          "description": "Quando uma unidade onde a maioria dos modelos tem esta regra sofre ferimentos, role um dado para cada um. Se o ferimento veio de uma magia, ele é ignorado com 2+. Se não veio de uma magia e a unidade foi alvo de tiros/carga a mais de 9\"/6\" de distância, ele é ignorado com 6+."
        },
        "zUTRifMzhyrR": {
          "name": "Bestial Aprimorado",
          "description": "Se este modelo tiver Bestial, os inimigos que recebem acertos dele devem rolar novamente resultados de Defesa não modificados bem-sucedidos de 5-6 por Bestial (em vez de apenas resultados de 6)."
        },
        "zVconc6Qb-g9": {
          "name": "Impacto Pesado",
          "description": "Conta como tendo Impacto(X) com acertos que têm PA(1)."
        },
        "ZW_Zv-kkBt2q": {
          "name": "Aura de Blindado",
          "description": "Este modelo e a sua unidade recebem Blindado."
        },
        "Zx4mWN0SbmK8": {
          "name": "Confiável",
          "description": "Ataca com Qualidade 2+."
        }
