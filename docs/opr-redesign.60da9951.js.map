          "description": "Once per activation, before attacking, pick one friendly unit within 12\", which gets Enhanced Primal once (next time the effect would apply)."
        },
        "0bcGY4Xr4NE0": {
          "name": "Brace",
          "description": "Enemies charging this unit get -X total Impact rolls, unless this unit is Fatigued."
        },
        "0dZak5jae8F0": {
          "name": "Melee Shrouding Aura",
          "description": "This model and its unit get Melee Shrouding."
        },
        "0TfnG5G4JEv0": {
          "name": "Anti-Regen",
          "description": "This weapon ignores Regeneration."
        },
        "0Z-OGtDpajc3": {
