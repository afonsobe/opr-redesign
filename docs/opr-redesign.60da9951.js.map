          "description": "This model gets Thrust on its weapons in melee."
        },
        "kS5WWHuH6qVe": {
          "name": "Increased Shooting Range Buff",
          "description": "Once per activation, before attacking, pick up to 3 friendly units within 12\", which gets +6\" range on its weapons when shooting once (next time the effect would apply)."
        },
        "s97hkNZ91jnd": {
          "name": "Enhanced Shadowborn Buff",
          "description": "Once per activation, before attacking, pick up to 3 friendly units within 12\", which gets Enhanced Shadowborn once (next time the effect would apply)."
        },
        "trV7P42DyQGH": {
          "name": "Thrust in Melee Buff",
          "description": "Once per activation, before attacking, pick up to 3 friendly units within 12\", which gets Thrust in Melee once (next time the effect would apply)."
        },
        "XWsun1sjt2ql": {
          "name": "Rapid Rush Buff",
          "description": "Once per activation, before attacking, pick up to 3 friendly units within 12\", which gets Rapid Rush once (next time the effect would apply)."
        },
        "ZGxUXLWSGkCv": {
          "name": "Enhanced Shadowborn",
          "description": "If most models in this unit have Shadowborn, enemy units shooting/charging it get -8\"/-4\" range to a min. of 6\" from Shadowborn (instead of only -4\"/-2\")."
        },
        "asZsQqR_73or": {
          "name": "Enhanced Versatile Warrior",
          "description": "If this model has Versatile Attack, it always gets either AP(+1) or +1 to hit rolls from Versatile Attack (instead of only when shooting/charging enemies over 9\"/6\" away)."
        },
        "iZkU-vhbjhbb": {
          "name": "Watchborn",
          "description": "When this unit is activated, pick one effect: until the end of the activation, when shooting/charging enemies over 9\"/6\" away, all models with this rule in it either get AP(+1) or get +1 to hit rolls."
        },
        "QteJvh1g5fgV": {
          "name": "Enhanced Watchborn Aura",
          "description": "This model's unit and up to 2 friendly units picked before the start of the game get Enhanced Watchborn. If this model is killed, picked models that are deployed lose the rule."
        },
        "rIgfEKIxk1CA": {
          "name": "Enhanced Watchborn",
          "description": "If this model has Versatile Attack, it always gets either AP(+1) or +1 to hit rolls from Versatile Attack (instead of only when shooting/charging enemies over 9\"/6\" away)."
        },
        "MmLijhHpEF37": {
          "name": "Enhanced Wolfborn",
          "description": "If this model has Wolfborn, it may move by up to 2D3\" from Wolfborn (instead of only D3\")."
        },
        "qlZWvJpEDLeD": {
          "name": "Enhanced Wolfborn Aura",
          "description": "This model's unit and up to 2 friendly units picked before the start of the game get Enhanced Wolfborn. If this model is killed, picked models that are deployed lose the rule."
        },
        "vfW0pVMUrKQr": {
          "name": "Wolfborn",
          "description": "When this unit is activated, you may move all models with this rule in it by up to D3\"."
        },
        "58bWJyFqRsC3": {
          "name": "Union Assault",
          "description": "After this model is deployed, it may be placed anywhere fully within 9\" of its position, over 9\" away from non-Vanguard enemy units."
        },
        "KTetx0KIX3i-": {
          "name": "Slayer Mark",
          "description": "Once per activation, before attacking, pick up to 3 enemy units within 18\" in line of sight, which friendly units gets Slayer against once (next time the effect would apply)."
