      "rules": {
        "_BgATbpwgnxc": {
          "name": "Swift Buff",
          "description": "Once per activation, before attacking, pick one friendly unit within 12\", which gets Swift once (next time the effect would apply)."
        },
        "_mrPya5SXSqW": {
          "name": "Deadly",
          "description": "Assign each wound to one model, and multiply it by X. Hits from Deadly must be resolved first, and these wounds don’t carry over to other models if the original target is killed."
        },
        "_T07iXWo4VwJ": {
          "name": "Parry",
          "description": "When this unit takes hits in melee, roll X dice per model with this rule in it, up to as many dice as hits taken. For each 6+ one hit is ignored (defender picks which)."
        },
        "_tP0jExjizvc": {
          "name": "Screened",
          "description": "If most models in this unit have this rule, enemy units shooting/charging them from over 9\"/6\" away get -1 to hit rolls ."
        },
