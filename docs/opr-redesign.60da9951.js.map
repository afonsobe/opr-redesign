        "WdkGC1Q6_nHY": {
          "name": "Aura de Guerreiro do Clã Aprimorado",
          "description": "Este modelo e a sua unidade recebem Guerreiro do Clã Aprimorado."
        },
        "wHfLIdlnEQ1a": {
          "name": "Entrincheirado",
          "description": "Se a maioria dos modelos nesta unidade tiver esta regra, enquanto não se moverem durante esta rodada, unidades inimigas que as atirem a mais de 12\" de distância sofrem -1 nas rolagens para acertar."
        },
        "WHJ8A7LzHUR6": {
          "name": "Violento",
          "description": "Quando este modelo atira ou carrega inimigos a mais de 9\"/6\" de distância, resultados não modificados de 1 ao bloquear acertos de armas causam 1 ferimento extra."
        },
        "wjTOj41tskFD": {
          "name": "Devastação",
          "description": "Quando este modelo atira ou carrega inimigos a mais de 9\"/6\" de distância, suas armas recebem PA(+1)."
