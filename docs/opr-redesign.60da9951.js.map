$770f9bfa8cb62ef9$exports = JSON.parse('{"meta":{"gameSystem":3,"system":"gff"},"systems":{"gff":{"meta":{"armyId":"i4ZEAmqeFSfAcw3f","gameSystem":3,"book":"Wormhole Daemons","collectedAt":"2026-11-09","system":"gff"},"rules":{"_mrPya5SXSqW":{"name":"Mortal","description":"Atribua cada ferimento a um \xfanico modelo e multiplique-o por X. Acertos de Mortal devem ser resolvidos primeiro, e esses ferimentos n\xe3o passam para outros modelos se o alvo original for morto."},"_T07iXWo4VwJ":{"name":"Aparar","description":"Quando esta unidade recebe acertos em combate corpo a corpo, role X dados por modelo com esta regra na unidade, at\xe9 o n\xfamero de acertos recebidos. Para cada 6+, um acerto \xe9 ignorado (o defensor escolhe qual)."},"-QJdqJEKjIpE":{"name":"Voador","description":"Pode se mover atrav\xe9s de unidades e terrenos e ignora os efeitos de terreno Dif\xedcil e Perigoso nos quais n\xe3o iniciou o movimento. Esta unidade passa automaticamente em rolagens de Salto."},"0bcGY4Xr4NE0":{"name":"Postura Defensiva","description":"Inimigos que carregam esta unidade sofrem -X no total de rolagens de Impacto, a menos que esta unidade esteja Fatigada."},"0dZak5jae8F0":{"name":"Aura de Encobrimento em Combate","description":"A unidade deste modelo e at\xe9 2 unidades aliadas escolhidas antes do in\xedcio do jogo recebem Encobrimento em Combate. Se este modelo for morto, os modelos escolhidos que estiverem em campo perdem a regra."},"17crjK7P6_w6":{"name":"PA (Penetra\xe7\xe3o de Armadura)","description":"Alvos sofrem -X nas rolagens de Defesa ao bloquear acertos."},"1TMBPe40kx2b":{"name":"Encobrimento em Combate","description":"Quando uma unidade onde a maioria dos modelos tem esta regra \xe9 alvo de carga por uma unidade inimiga, essa unidade inimiga sofre -2\\" de alcance, para um m\xednimo de 6\\"."},"2atvlmICQSCV":{"name":"Destemido","description":"Quando uma unidade onde a maioria dos modelos tem esta regra falha em um Teste de Moral, role um dado. Em 4+ conta como se tivesse passado."},"3FeiOe3krHMa":{"name":"Aeronave","description":"S\xf3 usa a\xe7\xf5es de Avan\xe7o, movendo em linha reta, e adiciona 30\\" ao movimento total (mesmo se Abalada). Aeronaves ignoram todas as unidades e terrenos ao se mover e parar, n\xe3o podem tomar ou contestar objetivos, n\xe3o podem ser cargadas, e unidades que as alvejarem sofrem -12\\" de alcance e -1 nas rolagens de acerto."},"47CAqf7ySlfc":{"name":"Conjurador","description":"Recebe X fichas de magia no in\xedcio de cada rodada, mas n\xe3o pode ter mais de 6 de uma vez. Uma vez por ativa\xe7\xe3o, antes de atacar, gaste tantas fichas quanto o valor da magia para tentar conjurar uma ou mais magias (s\xf3 uma tentativa por magia). Escolha um alvo e role um dado, e em 4+ resolva o efeito da magia. Modelos a at\xe9 18\\" do Conjurador podem gastar qualquer n\xfamero de fichas de magia ao mesmo tempo antes de rolar para dar +1/-1 na rolagem por ficha ao Conjurador."},"4Q1owB6yNFz1":{"name":"Amplificador de Magia","description":"Recebe +1 nas rolagens de conjura\xe7\xe3o."},"5v6oaGfrdf29":{"name":"Surto","description":"Para cada resultado n\xe3o modificado de 6 para acertar, esta arma causa 1 acerto extra (s\xf3 o acerto original conta como 6 para regras especiais)."},"62-mYKVM9MLd":{"name":"Impacto","description":"Ao carregar, antes de qualquer unidade atacar, role X dados, a menos que esta unidade esteja Fatigada. Para cada 2+, o alvo sofre 1 acerto."},"6mJw5IdqSqNC":{"name":"Emboscada","description":"Pode ser deixada de lado antes do posicionamento. No in\xedcio de qualquer rodada ap\xf3s a primeira, pode ser posicionada em qualquer lugar a mais de 9\\" das unidades inimigas. Os jogadores alternam o posicionamento de unidades com Emboscada, come\xe7ando pelo jogador que ser\xe1 o pr\xf3ximo a ativar. Unidades que entram por Emboscada n\xe3o podem tomar nem contestar objetivos na rodada em que s\xe3o posicionadas."},"741uN_Qma5mL":{"name":"Forjado na Batalha","description":"Se uma unidade onde a maioria dos modelos tem esta regra estiver Abalada no in\xedcio da rodada, role um dado. Em 4+ deixa de estar Abalada."},"74RjQ1k41DoO":{"name":"Armadura","description":"Conta como tendo Defesa X+."},"8Ck9GAwUK824":{"name":"Indireto","description":"Ao usar a\xe7\xf5es de Manter posi\xe7\xe3o e atirar, pode mirar inimigos que n\xe3o est\xe3o na linha de vis\xe3o como se estivessem, e ignora Cobertura de Bloqueadores de Vis\xe3o."},"8Hjy54TYtwb7":{"name":"Derrubar","description":"Este modelo pode escolher qualquer modelo da unidade alvo como alvo individual para os ataques desta arma, o que \xe9 resolvido como se fosse uma unidade de [1]. Ataques de Derrubar devem ser resolvidos antes de outras armas."},"8KujvrTG8k9p":{"name":"Regenera\xe7\xe3o","description":"Quando uma unidade onde a maioria dos modelos tem esta regra sofre ferimentos, role um dado para cada um. Em 5+, \xe9 ignorado."},"9042COVrLCsI":{"name":"Limitado","description":"S\xf3 pode ser usado uma vez por jogo."},"9jyvRoBODD-O":{"name":"Furtivo","description":"Quando unidades onde a maioria dos modelos tem esta regra s\xe3o alvo de tiros a mais de 9\\" de dist\xe2ncia, unidades inimigas sofrem -1 nas rolagens de acerto."},"9o03izVMZ-Xl":{"name":"Esmagar","description":"Ao atacar unidades a mais da metade do alcance desta arma, o alvo deve rolar novamente resultados de Defesa n\xe3o modificados de 6."},"a0YtInGiUDd6":{"name":"Resist\xeancia","description":"Uma vez que um modelo sofreu tantos ferimentos quanto seu valor de Resist\xeancia, ele \xe9 morto (removido de jogo)."},"aogQZcOOQrDI":{"name":"Transporte","description":"Pode transportar at\xe9 X modelos aliados com Resist\xeancia(3), ou Her\xf3is com Resist\xeancia at\xe9 18. N\xe3o-Her\xf3is com Resist\xeancia at\xe9 9 ocupam 3 espa\xe7os cada. Transportes podem ser posicionados com unidades dentro, e unidades podem entrar ou sair usando qualquer a\xe7\xe3o de movimento: para entrar, devem ficar a at\xe9 2\\" do transporte; para sair, devem ficar totalmente a at\xe9 6\\" dele. Unidades dentro e fora de transportes n\xe3o podem escolher umas \xe0s outras como alvo, mas podem escolher o pr\xf3prio transporte como alvo. Quando um transporte \xe9 destru\xeddo, as unidades dentro devem fazer um Teste de Terreno Perigoso, ficam Abaladas e devem ser colocadas totalmente a at\xe9 6\\" do transporte antes que ele seja removido."},"ayuikxkmDOmq":{"name":"Aura de Alcance Vers\xe1til","description":"A unidade deste modelo e at\xe9 2 unidades aliadas escolhidas antes do in\xedcio do jogo recebem Alcance Vers\xe1til. Se este modelo for morto, os modelos escolhidos que estiverem em campo perdem a regra."},"ba6LlbpoLkSu":{"name":"Aura de Ru\xedna ao Atirar","description":"A unidade deste modelo e at\xe9 2 unidades aliadas escolhidas antes do in\xedcio do jogo recebem Ru\xedna em suas armas ao atirar. Se este modelo for morto, os modelos escolhidos que estiverem em campo perdem a regra."},"c45Fw0D2oGOk":{"name":"Contra-Ataque","description":"Pode atacar primeiro com esta arma quando for alvo de uma carga, a menos que esta unidade esteja Fatigada."},"cavWDboL4ubs":{"name":"Dilacerante","description":"Ignora Regenera\xe7\xe3o, e para cada resultado n\xe3o modificado de 6 para acertar, esses acertos recebem PA(+4)."},"CQes0mDvF4bV":{"name":"PA (Penetra\xe7\xe3o de Armadura)","description":"Alvos sofrem -X nas rolagens de Defesa ao bloquear acertos."},"dIQ3SGl2J2Ew":{"name":"Medo","description":"Em combate corpo a corpo com este modelo, inimigos contam como tendo sofrido +X ferimentos ao verificar quem venceu."},"efmjJPTe0Yzd":{"name":"Anti-Cobertura","description":"Esta arma ignora Cobertura."},"FAMbscK5vhSu":{"name":"Batedor","description":"Pode ser deixada de lado antes do posicionamento. Ap\xf3s todas as outras unidades serem posicionadas, pode ser posicionada em qualquer lugar totalmente a at\xe9 9\\" da sua zona de posicionamento, a mais de 9\\" de unidades inimigas sem Batedor. Os jogadores alternam o posicionamento de unidades com Batedor, come\xe7ando pelo jogador que ser\xe1 o pr\xf3ximo a ativar."},"FF5ddXgx75lI":{"name":"Assalto","description":"Conta como arma de tiro e como arma de combate corpo a corpo."},"FRVSAjasmFSF":{"name":"Aura de Bravura","description":"A unidade deste modelo e at\xe9 2 unidades aliadas escolhidas antes do in\xedcio do jogo recebem +1 nas rolagens de Teste de Moral. Se este modelo for morto, os modelos escolhidos que estiverem em campo perdem a regra."},"GRuFoZiyjY5f":{"name":"Artilharia","description":"Quando este modelo usa uma a\xe7\xe3o de Manter posi\xe7\xe3o e atira em inimigos a mais de 12\\" de dist\xe2ncia, recebe +1 nas rolagens de acerto. Se a maioria dos modelos desta unidade tiver esta regra e a unidade n\xe3o tiver se movido nesta rodada, inimigos que atirarem nela de mais de 12\\" de dist\xe2ncia sofrem -1 nas rolagens de acerto."},"H9E9PIWpGRdw":{"name":"Implac\xe1vel","description":"Quando este modelo atira em inimigos a mais de 9\\" de dist\xe2ncia, resultado n\xe3o modificado de 6 para acertar causa 1 acerto extra (s\xf3 o acerto original conta como 6 para regras especiais)."},"HWtnPV9LQF1D":{"name":"Im\xf3vel","description":"S\xf3 pode usar a\xe7\xf5es de Manter posi\xe7\xe3o."},"IEJp3a4vE0CB":{"name":"Destro\xe7ar","description":"Para cada resultado n\xe3o modificado de 1 ao bloquear acertos, esta arma causa 1 ferimento extra."},"j93FkLXMCk8v":{"name":"Inabal\xe1vel","description":"Se uma unidade onde a maioria dos modelos tem esta regra estiver Abalada no in\xedcio da rodada, role um dado. Em 4+ deixa de estar Abalada."},"JoOCVPx1xT1G":{"name":"Furioso","description":"Ao carregar, resultado n\xe3o modificado de 6 para acertar causa 1 acerto extra (s\xf3 o acerto original conta como 6 para regras especiais)."},"JSKVyurtWIyW":{"name":"Andarilho","description":"Pode ignorar os efeitos de terreno Dif\xedcil. Esta unidade reduz pela metade o n\xfamero de dados que rola ao saltar (arredondando para cima)."},"KdgwlPb8LuD2":{"name":"R\xe1pido","description":"Move +2\\" ao usar Avan\xe7o e +4\\" ao usar Corrida/Carga."},"Ldhtmr4H8b6G":{"name":"Lento","description":"Move -2\\" ao usar Avan\xe7o e -4\\" ao usar Corrida/Carga."},"mETdyZ__yMVj":{"name":"Curar","description":"Uma vez por ativa\xe7\xe3o, antes de atacar, escolha um modelo aliado a at\xe9 3\\" com Resist\xeancia e remova D3 ferimentos dele."},"Naqc5mga9Uha":{"name":"Ru\xedna","description":"Ignora Regenera\xe7\xe3o, e ao atacar, o alvo deve rolar novamente resultados de Defesa n\xe3o modificados de 6."},"O_sf2rsHA7rD":{"name":"Evasivo","description":"Inimigos sofrem -1 nas rolagens de acerto ao atacar unidades onde a maioria dos modelos tem esta regra."},"qrG_DXJez5Dg":{"name":"M\xfasico","description":"A unidade deste modelo e at\xe9 2 unidades aliadas escolhidas antes do in\xedcio do jogo movem +1\\" ao usar a\xe7\xf5es de movimento. Se este modelo for morto, as unidades escolhidas que estiverem em campo perdem a regra."},"qsx__9Cz3au_":{"name":"Corrida R\xe1pida","description":"Este modelo move +6\\" ao usar a\xe7\xf5es de Corrida."},"QXyt-zV_bjpg":{"name":"Impar\xe1vel","description":"Esta arma ignora Regenera\xe7\xe3o e ignora todos os modificadores negativos que n\xe3o sejam das regras especiais deste modelo."},"RDFhn43ktRx8":{"name":"Aura de Corrida R\xe1pida","description":"A unidade deste modelo e at\xe9 2 unidades aliadas escolhidas antes do in\xedcio do jogo recebem Corrida R\xe1pida. Se este modelo for morto, os modelos escolhidos que estiverem em campo perdem a regra."},"s6MgSfmgylXU":{"name":"Defesa","description":"Este modelo recebe +X nas rolagens de Defesa."},"T08VkBuVmNZ_":{"name":"Her\xf3i","description":"Unidades a at\xe9 6\\" de Her\xf3is aliados podem usar a Qualidade do Her\xf3i em Testes de Moral, desde que o Her\xf3i n\xe3o esteja Abalado."},"umbiz4tnEyF8":{"name":"Estocada","description":"Ao carregar, recebe +1 nas rolagens de acerto e PA(+1) em combate corpo a corpo."},"V3YzPPkZm8at":{"name":"Aura de Regenera\xe7\xe3o","description":"A unidade deste modelo e at\xe9 2 unidades aliadas escolhidas antes do in\xedcio do jogo recebem Regenera\xe7\xe3o. Se este modelo for morto, os modelos escolhidos que estiverem em campo perdem a regra."},"w_vX0mi58KKt":{"name":"Explos\xe3o","description":"Ignora Cobertura e, ap\xf3s resolver as outras regras especiais, cada acerto \xe9 multiplicado por X. Os acertos devem ser divididos igualmente entre a unidade alvo e todas as unidades inimigas a at\xe9 3\\" de qualquer modelo da unidade alvo (o defensor escolhe como), mas cada unidade s\xf3 pode receber at\xe9 tantos acertos quanto modelos tiver."},"XoDRL2xVEnVf":{"name":"Aura de Ru\xedna em Combate","description":"A unidade deste modelo e at\xe9 2 unidades aliadas escolhidas antes do in\xedcio do jogo recebem Ru\xedna em suas armas em combate corpo a corpo. Se este modelo for morto, os modelos escolhidos que estiverem em campo perdem a regra."},"y47PXwakTSji":{"name":"Alcance Vers\xe1til","description":"Quando esta unidade \xe9 ativada, escolha um efeito: at\xe9 o fim da ativa\xe7\xe3o, todos os modelos com esta regra nesta unidade recebem +4\\" de alcance ao atirar ou movem +2\\" ao usar Corrida/Carga."},"ywXKQKPOLjTF":{"name":"Estandarte","description":"A unidade deste modelo e at\xe9 2 unidades aliadas escolhidas antes do in\xedcio do jogo recebem +1 nas rolagens de Teste de Moral causadas por tiros ou combate corpo a corpo. Se este modelo for morto, as unidades escolhidas que estiverem em campo perdem a regra."},"z4QuSO_AxqDr":{"name":"Perito Vers\xe1til","description":"Quando esta unidade \xe9 ativada, escolha um efeito: at\xe9 o fim da ativa\xe7\xe3o, todos os modelos com esta regra nesta unidade recebem PA(+1) ao atacar ou +1 nas rolagens de acerto ao atacar."},"zjzB46LX-QDg":{"name":"Reposicionamento","description":"Ap\xf3s todas as outras unidades serem posicionadas (exceto as que foram deixadas de lado), voc\xea pode retirar at\xe9 duas unidades aliadas da mesa e posicion\xe1-las novamente. Os jogadores alternam o posicionamento de unidades com Reposicionamento, come\xe7ando pelo jogador que ser\xe1 o pr\xf3ximo a ativar."},"Zx4mWN0SbmK8":{"name":"Confi\xe1vel","description":"Ataca com Qualidade 2+."},"09SoiR1HuW7u":{"name":"Preciso","description":"Recebe +1 nas rolagens para acertar ao atacar."},"1cykqbg4xn6o":{"name":"Aura de Carga R\xe1pida","description":"A unidade deste modelo e at\xe9 2 unidades aliadas escolhidas antes do in\xedcio do jogo movem +4\\" ao usar a\xe7\xf5es de Carga. Se este modelo for morto, as unidades escolhidas que estiverem em campo perdem a regra."},"1elLRhGK7ETb":{"name":"Penalidade de Precis\xe3o","description":"Uma vez por ativa\xe7\xe3o, antes de atacar, escolha at\xe9 3 unidades inimigas a at\xe9 18\\" na linha de vis\xe3o. Elas recebem -1 nas rolagens para acertar ao atacar uma vez, na pr\xf3xima vez que o efeito se aplicar."},"3sXTViTVdDhn":{"name":"Aura Predadora","description":"A unidade deste modelo e at\xe9 2 unidades aliadas escolhidas antes do in\xedcio do jogo recebem Predador. Se este modelo for morto, as unidades escolhidas que estiverem em campo perdem a regra."},"aiYEmCuDPUcM":{"name":"Predador","description":"Para cada resultado n\xe3o modificado de 6 para acertar ao atacar, este modelo pode fazer 1 ataque adicional com essa arma. Esta regra n\xe3o se aplica aos ataques gerados dessa forma."},"anyZ2FHtdAVO":{"name":"Combatente de Ataque e Fuga","description":"Uma vez por rodada, este modelo pode mover at\xe9 3\\" depois de participar de um combate corpo a corpo."},"BOqSaZoY3ewJ":{"name":"Impreciso","description":"Recebe -1 nas rolagens para acertar ao atacar."},"cgCroTrOmiv-":{"name":"V\xednculo de Colmeia","description":"Se a maioria dos modelos nesta unidade tiver esta regra, a unidade recebe +1 nas rolagens de Teste de Moral quando for alvo de tiros a mais de 9\\" ou de uma carga iniciada a mais de 6\\"."},"CK9TIa7vdehO":{"name":"Aura de F\xfaria","description":"A unidade deste modelo e at\xe9 2 unidades aliadas escolhidas antes do in\xedcio do jogo recebem Furioso. Se este modelo for morto, as unidades escolhidas que estiverem em campo perdem a regra."},"cnKvLv8ErzIc":{"name":"B\xf4nus de Furtividade","description":"Uma vez por ativa\xe7\xe3o, antes de atacar, escolha at\xe9 3 unidades aliadas a at\xe9 12\\". Elas recebem Furtivo uma vez, na pr\xf3xima vez que o efeito se aplicar."},"DEeVIJcfNfS6":{"name":"Combatente Imprevis\xedvel","description":"Em combate corpo a corpo, role um dado e aplique um efeito a todos os modelos com esta regra: com 1\u20133, recebem PA(+1); com 4\u20136, recebem +1 nas rolagens para acertar."},"djJahpu0Ciut":{"name":"Infiltra\xe7\xe3o","description":"Conta como tendo Emboscada, mas pode ser posicionada em qualquer lugar a mais de 3\\" de qualquer unidade inimiga."},"F_1wfmpAyYwT":{"name":"Autodestrui\xe7\xe3o","description":"Se este modelo for morto em combate corpo a corpo, a unidade atacante sofre X acertos. Se este modelo sobreviver ao combate corpo a corpo, depois que ambos os lados terminarem de atacar, ele \xe9 morto imediatamente e a unidade inimiga sofre X acertos."},"GgPKQ4tKFRIC":{"name":"Desajeitado","description":"Ataca por \xfaltimo ao usar uma a\xe7\xe3o de Carga."},"h-Cj1XrX00JE":{"name":"Resist\xeancia a Magia","description":"Quando uma unidade em que a maioria dos modelos tem esta regra sofre ferimentos, role um dado para cada ferimento. Se o ferimento veio de uma magia, ele \xe9 ignorado com 2+. Se n\xe3o veio de uma magia, \xe9 ignorado com 6+."},"HMiVg3VVLQv3":{"name":"Alvo Perfur\xe1vel","description":"Uma vez por jogo, durante a ativa\xe7\xe3o deste modelo e antes de atacar, escolha X unidades inimigas a at\xe9 18\\" e na linha de vis\xe3o deste modelo e coloque 1 marcador em cada uma. Unidades aliadas recebem PA(+1) em suas armas ao atacar essas unidades."},"kiXI7plPE_mK":{"name":"V\xednculo de Colmeia Aprimorado","description":"Se a maioria dos modelos nesta unidade tiver V\xednculo de Colmeia, a unidade sempre recebe o +1 nas rolagens de Teste de Moral dessa regra, e n\xe3o apenas quando for alvo de tiros a mais de 9\\" ou de uma carga iniciada a mais de 6\\"."},"LbpquFUyGSZ7":{"name":"Valoroso","description":"Se a maioria dos modelos nesta unidade tiver esta regra, a unidade recebe +1 nas rolagens de Teste de Moral quando for alvo de tiros a mais de 9\\" ou de uma carga iniciada a mais de 6\\"."},"nLQCr5OiSlYz":{"name":"Conjurador de Grupo","description":"Conta como tendo Conjurador(1)."},"O2Cd7OibBBA5":{"name":"Sem Retirada","description":"Quando uma unidade em que a maioria dos modelos tem esta regra falha em um Teste de Moral que a deixaria Abalada ou a faria Fugir, o teste \xe9 considerado bem-sucedido. Em seguida, role tantos dados quanto os ferimentos necess\xe1rios para destru\xed-la completamente; para cada resultado de 1\u20133, a unidade sofre 1 ferimento que n\xe3o pode ser ignorado."},"QWzGAg9RpE2D":{"name":"Aura de Alcance de Tiro Aumentado","description":"A unidade deste modelo e at\xe9 2 unidades aliadas escolhidas antes do in\xedcio do jogo recebem +6\\" de alcance em suas armas ao atirar. Se este modelo for morto, as unidades escolhidas que estiverem em campo perdem a regra."},"RHkw66BqDjUp":{"name":"Fragmenta\xe7\xe3o","description":"Ao atacar unidades em que a maioria dos modelos tem Defesa de 4+ a 6+, o alvo deve rolar novamente os resultados naturais bem-sucedidos de Defesa de 4 a 6."},"rqBYj1yANC3J":{"name":"Her\xf3i \xdanico","description":"Conta como tendo Her\xf3i, e este modelo s\xf3 pode ser inclu\xeddo uma vez por ex\xe9rcito."},"s4lagBUlnsUE":{"name":"Crescimento Perfurante","description":"Coloque 1 marcador nesta unidade no in\xedcio de cada rodada se ela estiver em campo e n\xe3o estiver Abalada, at\xe9 o m\xe1ximo de 4 marcadores. Para cada 2 marcadores, os modelos com esta regra nesta unidade recebem PA(+1) em suas armas."},"TbjUdR-OJZPw":{"name":"Valoroso Aprimorado","description":"Se a maioria dos modelos nesta unidade tiver Valoroso, a unidade sempre recebe o +1 nas rolagens de Teste de Moral dessa regra, e n\xe3o apenas quando for alvo de tiros a mais de 9\\" ou de uma carga iniciada a mais de 6\\"."},"WNMH1ZiQXSz-":{"name":"Canalizador de Magia","description":"Conjuradores de outras unidades aliadas a at\xe9 12\\" podem lan\xe7ar magias como se estivessem na posi\xe7\xe3o deste modelo e recebem +1 nas rolagens de conjura\xe7\xe3o ao faz\xea-lo. Conjuradores aliados s\xf3 podem usar esta regra se esta unidade n\xe3o estiver Abalada."},"Yt2R4sh8SXM0":{"name":"Aura de V\xednculo de Colmeia Aprimorado","description":"A unidade deste modelo e at\xe9 2 unidades aliadas escolhidas antes do in\xedcio do jogo recebem V\xednculo de Colmeia Aprimorado. Se este modelo for morto, as unidades escolhidas que estiverem em campo perdem a regra."},"2W8l0OXSjju6":{"name":"Berserker Aprimorado","description":"Se este modelo tiver Berserker, o alvo sempre sofre acertos em resultados de acerto n\xe3o modificados de 6 da regra Berserker, e n\xe3o apenas ao atirar ou carregar inimigos a mais de 9\\"/6\\" de dist\xe2ncia."},"5NeMSSj7-Pp5":{"name":"Violento Aprimorado","description":"Se este modelo tiver Violento, os inimigos sempre sofrem ferimentos em resultados n\xe3o modificados de 1 ao bloquear da regra Violento, e n\xe3o apenas ao atirar ou carregar inimigos a mais de 9\\"/6\\" de dist\xe2ncia."},"8haZ36fXvnzn":{"name":"Aura de Furtividade","description":"A unidade deste modelo e at\xe9 2 unidades aliadas escolhidas antes do in\xedcio do jogo recebem Furtivo. Se este modelo for morto, as unidades escolhidas que estiverem em campo perdem a regra."},"8UUSt1RIIyEa":{"name":"Ca\xe7ador de Badlands Aprimorado","description":"Se este modelo tiver Ca\xe7ador de Badlands, os inimigos sempre sofrem ferimentos em resultados n\xe3o modificados de 1 ao bloquear da regra Ca\xe7ador de Badlands, e n\xe3o apenas ao atirar ou carregar inimigos a mais de 9\\"/6\\" de dist\xe2ncia."},"a9j1Pje6TLBi":{"name":"Aura de Tiro 