        "wnEVftbtVtw5": {
          "name": "Aura de Cavaleiro Nato Aprimorado",
          "description": "Este modelo e a sua unidade recebem Cavaleiro Nato Aprimorado."
        },
        "WNMH1ZiQXSz-": {
          "name": "Canalizador de Magia",
